@model PersonResponse
@{
    ViewBag.Title = "Delete";
}

<a href="~/persons/index" class="link-hover">Back to Persons List</a>
<h2>Are you sure you want to delete this person?</h2>

<div class="w-50">
    <form asp-controller="Persons" asp-action="Delete" method="post">

        <input asp-for="PersonID" hidden="hidden" />

        @*PersonName*@
        <div class="form-field flex">
            <div class="w-25">
                <label asp-for="@Model.PersonName" class="form-label pt">Person Name</label>
            </div>
            <div class="flex-1">
                <input asp-for="@Model.PersonName" disabled="disabled" class="form-input" />
            </div>
        </div>


        @*Email*@
        <div class="form-field flex">
            <div class="w-25">
                <label asp-for="@Model.Email" class="form-label pt">Email</label>
            </div>
            <div class="flex-1">
                <input asp-for="@Model.Email" disabled="disabled" class="form-input" />
            </div>
        </div>

       

        @*Submit*@
        <div class="form-field flex">
            <div class="w-25">
            </div>
            <div class="flex-1">
                <button class="button button-green-back">Delete</button>
            </div>
        </div>

    </form>
</div>